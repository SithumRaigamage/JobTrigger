// Jenkins mirror of .github/workflows/security.yml. Phase 27. The GitHub
// workflow is the live CI; this Declarative pipeline is the Jenkins-side
// mirror.

pipeline {
  agent any

  options { timestamps() }

  stages {
    stage('Checkout') {
      steps { checkout scm }
    }

    stage('Install gitleaks') {
      agent { docker { image = 'alpine:3.20' } }
      steps {
        sh '''
          curl -sSfLO "https://github.com/gitleaks/gitleaks/releases/download/v8.30.1/gitleaks_8.30.1_linux_x64.tar.gz"
          curl -sSfL "https://github.com/gitleaks/gitleaks/releases/download/v8.30.1/gitleaks_8.30.1_checksums.txt" | grep " gitleaks_8.30.1_linux_x64.tar.gz\\$" | sha256sum -c -
          tar xzf "gitleaks_8.30.1_linux_x64.tar.gz" gitleaks
        '''
      }
    }

    stage('Scan history for secrets') {
      agent { docker { image = 'alpine:3.20' } }
      steps { sh './gitleaks git --redact --no-banner --exit-code 1 .' }
    }

    stage('Install osv-scanner') {
      agent { docker { image = 'ubuntu:22.04' } }
      steps {
        sh '''
          curl -sSfLO "https://github.com/google/osv-scanner/releases/download/v2.7.0/osv-scanner_linux_amd64"
          curl -sSfL "https://github.com/google/osv-scanner/releases/download/v2.7.0/OSV_SCANNER_SHA256SUMS" | grep " osv-scanner_linux_amd64\\$" | sha256sum -c -
          chmod +x osv-scanner_linux_amd64
        '''
      }
    }

    stage('Scan lockfiles for known vulnerabilities') {
      agent { docker { image = 'ubuntu:22.04' } }
      steps {
        sh '''
          ./osv-scanner_linux_amd64 scan source \
            --config osv-scanner.toml \
            -L JobTrigger-Frontend/pubspec.lock \
            -L JobTrigger-Backend/package-lock.json \
            -L JobTrigger-Web/package-lock.json
        '''
      }
    }

    stage('Build backend Docker image') {
      agent { docker { image = 'docker:27' } }
      steps { sh 'cd JobTrigger-Backend && docker build -t jobtrigger-backend:ci .' }
    }

    stage('Install trivy') {
      agent { docker { image = 'alpine:3.20' } }
      steps {
        sh '''
          curl -sSfLO "https://github.com/aquasecurity/trivy/releases/download/0.76.0/trivy_0.76.0_Linux-64bit.tar.gz"
          curl -sSfL "https://github.com/aquasecurity/trivy/releases/download/0.76.0/trivy_0.76.0_Linux-64bit_SHA256SUMS" | grep " trivy_0.76.0_Linux-64bit.tar.gz\\$" | sha256sum -c -
          tar xzf "trivy_0.76.0_Linux-64bit.tar.gz" trivy
        '''
      }
    }

    stage('Scan the image') {
      agent { docker { image = 'aquasec/trivy:0.76.0' } }
      steps {
        sh '''
          ./trivy image --scanners vuln,secret --severity HIGH,CRITICAL \
            --ignore-unfixed --exit-code 1 --no-progress jobtrigger-backend:ci
        '''
      }
    }
  }
}
