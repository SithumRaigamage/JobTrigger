<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	App Sandbox is off for this local-dev-only macOS target (CLAUDE.md scopes
	App Store distribution to iOS + Android; macOS here is a dev convenience,
	not a shipped platform). Sandboxed builds need com.apple.security.network
	.client/server and keychain-access-groups entitlements for
	dio/flutter_secure_storage to work at all -- and keychain-access-groups
	specifically requires signing with a real Apple Developer certificate
	(errSecMissingEntitlement / "development certificate" build error
	otherwise), which isn't available in this environment. Revisit if macOS
	is ever added as a real distribution target.
	-->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>
