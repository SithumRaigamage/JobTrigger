<?xml version="1.0" encoding="utf-8"?>
<!-- AUD-64/NEW-03: app data must never be backed up to (or restored from) Google
     Drive or copied to a new device. `allowBackup="false"` in the manifest
     already disables both paths; these rules state the same intent in the
     valid Android 12+ <data-extraction-rules> schema so lint (and a Play
     release build) accepts the file. Both SharedPreferences (cached email,
     watch list, pinned job URLs) and the flutter_secure_storage blobs live
     here, and must never land as readable data on another device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
