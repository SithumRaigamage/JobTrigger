<?xml version="1.0" encoding="utf-8"?>
<!-- Launch splash before Android 12 (P16-03): the Concept B glyph centred on
     the icon navy. Android 12+ draws the system splash from values-v31. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ic_launcher_background" />
    <!-- 288dp matches the Android 12+ splash icon size, so the glyph is the
         same size on every version. -->
    <item
        android:width="288dp"
        android:height="288dp"
        android:drawable="@drawable/ic_launcher_foreground"
        android:gravity="center" />
</layer-list>
