# Example environment variables for JobTrigger-Backend
# Copy this file to `.env` and replace values before running the server.

# MongoDB connection string. For local development, a typical value is:
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/jobtrigger

# JWT secret used to sign authentication tokens. Use a strong, random string in production.
JWT_SECRET=

# Port to run the Express server on (optional). Defaults to 5001 when not set.
PORT=5001

# Path to frontend resources used by the migration script. Optional — only needed
# if you plan to run `npm run migrate` which reads JSON files in the frontend resources.
# Example: /Users/you/projects/JobTrigger/Lab-Trigger-frontend/Lab-Trigger-frontend/Resources
FRONTEND_RESOURCES_PATH=

# NODE_ENV can be 'development' or 'production'
NODE_ENV=development

CREDENTIALS_ENCRYPTION_KEY=


SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM=JobTrigger <your-address@gmail.com>
RESET_PASSWORD_URL=<see below>

# Phase 21: student plan
STUDENT_ADMIN_EMAIL=
STUDENT_RENEWAL_ENABLED=false

FCM_SERVICE_ACCOUNT=

# Development-only local billing sandbox (never in production)
SANDBOX_BILLING=

# Local development defaults (setup-dev.sh exports these; dotenv does not
# override values already in the environment).
PORT=5001
BILLING_ENABLED=true
SANDBOX_BILLING=true

# Contact support address (optional; default support@<SITE_URL domain>)
SUPPORT_EMAIL=


# Team plan (US-SUB-11, release 1.1): off unless true; Paddle per-seat prices
TEAM_PLAN_ENABLED=false
PADDLE_PRICE_TEAM_MONTHLY=
PADDLE_PRICE_TEAM_YEARLY=

# Oldest app version allowed (US-PROF-03), e.g. 1.0.1; empty blocks nobody
MIN_SUPPORTED_APP_VERSION=
