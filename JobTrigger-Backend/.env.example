# Example environment variables for lab-trigger-backend
# Copy this file to `.env` and replace values before running the server.

# MongoDB connection string. For local development, a typical value is:
# MONGODB_URI=mongodb://localhost:27017/jobtrigger
MONGODB_URI=mongodb://localhost:27017/jobtrigger

# JWT secret used to sign authentication tokens. Use a strong, random string in production.
JWT_SECRET=

# Port to run the Express server on (optional). Defaults to 5001 when not set.
PORT=5001

# Path to frontend resources used by the migration script. Optional — only needed
# if you plan to run `npm run migrate` which reads JSON files in the frontend resources.
# Example: /Users/you/projects/JobTrigger/Lab-Trigger-frontend/Lab-Trigger-frontend/Resources
FRONTEND_RESOURCES_PATH=

# NODE_ENV can be 'development' or 'production'
NODE_ENV=development
